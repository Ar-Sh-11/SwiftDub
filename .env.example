# SwiftDub — environment configuration
# Copy to .env and adjust for your deployment

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── GPU (NVIDIA L4 = 23 GB VRAM) ─────────────────────────────────────────────
GPU_IDS=0
GPU_VRAM_DEFAULT_GB=23.0
LATENTSYNC_VRAM_GB=10.0
MAX_CONCURRENT_JOBS=2

# ── Memory / cache gating ─────────────────────────────────────────────────────
MEMORY_CACHE_DISABLE_PCT=95.0
GPU_CLEAR_CACHE_PCT=85.0

# ── LatentSync model ──────────────────────────────────────────────────────────
LATENTSYNC_UNET_CONFIG=configs/unet/stage2.yaml
LATENTSYNC_INFERENCE_STEPS=20
LATENTSYNC_GUIDANCE_SCALE=1.5
LATENTSYNC_SEED=1247
LATENTSYNC_ENABLE_DEEPCACHE=false

# ── External services ─────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=swiftdub
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2

# ── Dev overrides ─────────────────────────────────────────────────────────────
DISABLE_CACHE=false
DISABLE_DB=false

# ── Models ────────────────────────────────────────────────────────────────────
MUSETALK_DISABLED=true

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
TZ=Asia/Kolkata
