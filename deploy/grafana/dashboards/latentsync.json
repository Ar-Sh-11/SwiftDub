{
  "title": "SwiftDub — LatentSync Dubbing",
  "uid": "latentsync-prod",
  "version": 1,
  "schemaVersion": 37,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Requests",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(latentsync_requests_total)",
        "legendFormat": "Total"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"blue","value":null}] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Successful Dubs",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(latentsync_requests_total{status='success'})",
        "legendFormat": "Success"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":null}] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Failed Dubs",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(latentsync_requests_total{status='error'})",
        "legendFormat": "Errors"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":null}] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Active Jobs",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "latentsync_active_jobs", "legendFormat": "Active" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"blue","value":null},{"color":"yellow","value":1},{"color":"red","value":3}] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Success Rate",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(latentsync_requests_total{status='success'}[5m]) / rate(latentsync_requests_total[5m]) * 100",
        "legendFormat": "%"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":null},{"color":"yellow","value":80},{"color":"green","value":95}] } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Request Rate (req/min)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(latentsync_requests_total{status='success'}[1m])*60", "legendFormat": "success" },
        { "expr": "rate(latentsync_requests_total{status='error'}[1m])*60", "legendFormat": "error" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Inference Latency",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(latentsync_inference_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, rate(latentsync_inference_duration_seconds_bucket[5m]))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.99, rate(latentsync_inference_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8, "type": "bargauge", "title": "Batch Size Distribution",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "targets": [{ "expr": "sum(rate(latentsync_batch_size_bucket[1h])) by (le)", "legendFormat": "{{le}}" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 9, "type": "gauge", "title": "Active / Max Concurrent",
      "gridPos": { "x": 8, "y": 12, "w": 6, "h": 6 },
      "targets": [{ "expr": "latentsync_active_jobs", "legendFormat": "Active" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 4, "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":2},{"color":"red","value":4}] } } }
    }
  ]
}
